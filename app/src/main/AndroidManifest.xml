<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Deliberately NO <uses-permission> entries:
        - no INTERNET (nothing leaves the device)
        - no SYSTEM_ALERT_WINDOW (edge strips are TYPE_ACCESSIBILITY_OVERLAY windows owned by the
          accessibility service, which does not need "Display over other apps")
        - no FOREGROUND_SERVICE (an enabled accessibility service is already kept alive by the system)
        - no QUERY_ALL_PACKAGES (app/shortcut pickers use the narrow <queries> below)
    -->

    <queries>
        <!-- Lets the "Launch app" picker list launchable apps. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets the "Launch shortcut" picker list apps that offer shortcut creators. -->
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.EdgeOne">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EdgeOne">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.EdgeAccessibilityService"
            android:exported="false"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
